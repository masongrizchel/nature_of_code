# Example 1.4 & 1.5: Vector multiplication and magnitude[cite: 16, 18]
def setup():
    size(200, 200)
    smooth()

def draw():
    background(255)
    mouse = PVector(mouseX, mouseY)
    center = PVector(width/2, height/2)
    mouse.sub(center)
    
    # Multiplication
    mouse.mult(0.5) 
    
    # Magnitude
    m = mouse.mag()
    fill(0)
    rect(0, 0, m, 10)
    
    translate(width/2, height/2)
    line(0, 0, mouse.x, mouse.y)
