# Example 1.1: Bouncing ball with no vectors[cite: 3]
x = 100
y = 100
xspeed = 1
yspeed = 3.3

def setup():
    size(200, 200)
    smooth()
    background(255)

def draw():
    global x, y, xspeed, yspeed
    background(255)
    
    x = x + xspeed
    y = y + yspeed

    if x > width or x < 0:
        xspeed = xspeed * -1
    if y > height or y < 0:
        yspeed = yspeed * -1

    stroke(0)
    fill(175)
    ellipse(x, y, 16, 16)
