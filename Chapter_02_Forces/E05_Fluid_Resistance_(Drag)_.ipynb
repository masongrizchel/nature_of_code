{
  "classes": {
    "Liquid": {
      "name": "Liquid",
      "methods": {
        "__init__": {
          "parameters": ["self", "x", "y", "w", "h", "c"],
          "body": "self.x, self.y, self.w, self.h = x, y, w, h\nself.c = c # Coefficient of drag"
        },
        "display": {
          "parameters": ["self"],
          "body": "no_stroke()\nfill(175)\nrect(self.x, self.y, self.w, self.h)"
        }
      }
    },
    "Mover_additions": {
      "note": "Add these methods to the Mover class:",
      "methods": {
        "is_inside": {
          "parameters": ["self", "l"],
          "body": "# Determines if the location is inside the Liquid rectangle\nreturn (self.location.x > l.x and self.location.x < l.x + l.w and \n        self.location.y > l.y and self.location.y < l.y + l.h)"
        },
        "drag": {
          "parameters": ["self", "l"],
          "body": "speed = self.velocity.magnitude\ndrag_magnitude = l.c * speed * speed # Force magnitude: Cd * v^2\n\ndrag_force = self.velocity.copy()\ndrag_force *= -1\ndrag_force.normalize() # Force direction: -1 * velocity unit vector\ndrag_force *= drag_magnitude\nself.apply_force(drag_force)"
        }
      }
    }
  }
}
