{
  "classes": {
    "Mover_additions": {
      "note": "Add this method to the Mover class",
      "methods": {
        "attract": {
          "parameters": [
            "self",
            "m"
          ],
          "body": "force = self.location - m.location\ndistance = constrain(force.magnitude, 5.0, 25.0)\nforce.normalize()\nG = 8.4\nstrength = (G * self.mass * m.mass) / (distance * distance)\nforce *= strength\nreturn force"
        }
      }
    }
  },
  "functions": {
    "draw": {
      "parameters": [],
      "body": "background(255)\nfor i, m1 in enumerate(movers):\n    for j, m2 in enumerate(movers):\n        if i != j: # Don't attract yourself\n            force = m2.attract(m1)\n            m1.apply_force(force)\n    \n    m1.update()\n    m1.display()"
    }
  }
}
