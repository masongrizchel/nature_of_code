      "body": "background(255)\nwind = Vector(0.001, 0)\ngravity = Vector(0, 0.1)\n\nfor m in movers:\n    c = 0.01 # Friction coefficient\n    friction = m.velocity.copy()\n    friction *= -1 # Opposite direction of velocity\n    friction.normalize()\n    friction *= c # Apply magnitude\n\n    m.apply_force(friction) # Apply friction force\n    m.apply_force(wind)\n    m.apply_force(gravity)\n    m.update()\n    m.display()\n    m.check_edges()"
    }
  }
