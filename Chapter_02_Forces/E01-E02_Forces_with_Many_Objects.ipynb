{
  "global_variables": {
    "movers": "[]"
  },
  "functions": {
    "setup": {
      "parameters": [],
      "body": "size(400, 400)\n# Initialize many Mover objects with random mass\nfor i in range(100):\n    movers.append(Mover(random_uniform(0.1, 5), 0, 0))"
    },
    "draw": {
      "parameters": [],
      "body": "background(255)\nwind = Vector(0.01, 0)\ngravity = Vector(0, 0.1)\n\nfor m in movers:\n    m.apply_force(wind) # Apply wind force\n    m.apply_force(gravity) # Apply gravity force\n    m.update()\n    m.display()\n    m.check_edges()"
    }
  }
}
