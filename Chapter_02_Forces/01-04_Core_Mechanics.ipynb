{
  "imports": [
    "from p5 import *"
  ],
  "class": {
    "name": "Mover",
    "methods": {
      "__init__": {
        "parameters": ["self", "m", "x", "y"],
        "body": "self.mass = m\nself.location = Vector(x, y)\nself.velocity = Vector(0, 0)\nself.acceleration = Vector(0, 0)"
      },
      "apply_force": {
        "parameters": ["self", "force"],
        "body": "# Make a copy of the force vector before dividing by mass\nf = force.copy()\nf /= self.mass\nself.acceleration += f # Force accumulation"
      },
      "update": {
        "parameters": ["self"],
        "body": "self.velocity += self.acceleration\nself.location += self.velocity\nself.acceleration *= 0 # Clear acceleration each frame"
      },
      "display": {
        "parameters": ["self"],
        "body": "stroke(0)\nfill(175)\ncircle(self.location.x, self.location.y, self.mass * 16)"
      },
      "check_edges": {
        "parameters": ["self"],
        "body": "if self.location.x > width:\n    self.location.x = width\n    self.velocity.x *= -1\nelif self.location.x < 0:\n    self.location.x = 0\n    self.velocity.x *= -1\n\nif self.location.y > height:\n    self.location.y = height\n    self.velocity.y *= -1"
      }
    }
  }
}
