{
  "classes": {
    "Attractor": {
      "name": "Attractor",
      "methods": {
        "__init__": {
          "parameters": [
            "self"
          ],
          "body": "self.location = Vector(width/2, height/2)\nself.mass = 20\nself.G = 8.4 # Gravitational constant"
        },
        "attract": {
          "parameters": [
            "self",
            "m"
          ],
          "body": "force = self.location - m.location # Vector pointing to attractor\ndistance = force.magnitude\ndistance = constrain(distance, 5.0, 25.0) # Constrain to avoid extremes\n\nforce.normalize()\n# Gravity formula\nstrength = (self.G * self.mass * m.mass) / (distance * distance)\nforce *= strength\nreturn force"
        },
        "display": {
          "parameters": [
            "self"
          ],
          "body": "stroke(0)\nfill(175, 200)\ncircle(self.location.x, self.location.y, self.mass * 2)"
        }
      }
    }
  },
  "global_variables": {
    "attractor": "Attractor()"
  },
  "functions": {
    "draw": {
      "parameters": [],
      "body": "background(255)\nattractor.display()\n\nfor m in movers:\n    force = attractor.attract(m) # Calculate attraction force\n    m.apply_force(force)\n    m.update()\n    m.display()"
    }
  }
}
